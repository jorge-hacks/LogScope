# =============================================================================
# LogScope - configuracion de ejemplo
# Copia este fichero a .env y ajusta los valores:
#     cp .env.example .env
# .env esta en .gitignore y NO se sube al repositorio.
# =============================================================================

# --- Servidor web -----------------------------------------------------------
LOGSCOPE_HOST=127.0.0.1
LOGSCOPE_PORT=8000

# --- Motor opencode ---------------------------------------------------------
# Ruta al ejecutable de opencode (opcional si esta en el PATH).
# LOGSCOPE_OPENCODE_BIN=/home/kali/.opencode/bin/opencode

# Puerto del servidor headless de opencode que gestiona la aplicacion.
LOGSCOPE_OPENCODE_PORT=4099

# Proveedor unico permitido. LogScope solo lista modelos de este proveedor.
LOGSCOPE_PROVIDER=opencode-go

# Modelo por defecto para el analisis (formato provider/model).
# Debe existir en el catalogo vivo de opencode-go.
LOGSCOPE_MODEL=opencode-go/gpt-6-luna

# Modelo auxiliar para tareas internas de opencode (titulos, compaction).
# Se recomienda uno gratuito.
LOGSCOPE_SMALL_MODEL=opencode-go/hy4-flash-free

# Agente de opencode que ejecuta el analisis forense.
LOGSCOPE_AGENT=log-analyst

# Cadena de fallback, separada por comas. Se usa si el modelo principal
# deja de estar disponible (HTTP 500 UnknownError).
LOGSCOPE_FALLBACK_MODELS=opencode-go/deepseek-v4.1-flash,opencode-go/beam-free

# --- Almacenamiento ----------------------------------------------------------
# Directorio raiz de los espacios de trabajo (un subdirectorio por analisis).
LOGSCOPE_WORKSPACES=workspaces

# Tamano maximo de archivo subido en MB.
LOGSCOPE_MAX_UPLOAD_MB=64

# Segundos maximos que se espera a que termine el turno del agente.
# Un turno puede quedarse colgado (una llamada a herramienta que no se
# resuelve): al expirar se comprueba si el informe ya esta escrito.
LOGSCOPE_ANALYSIS_TIMEOUT=900

# --- LogScope ----------------------------------------------------------------
LOG_LEVEL=INFO
